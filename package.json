{
  "name": "buttpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/main.ts --config buttpad.config.json --dev",
    "start": "bun src/server/main.ts --config buttpad.config.json",
    "example": "bun src/server/main.ts --config examples/buttpad.example.json",
    "test": "bun test",
    "e2e": "scripts/pw-env.sh npx playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "schema": "bun scripts/emit-schema.ts",
    "compile": "bun build --compile src/server/main.ts --outfile dist/buttpad"
  },
  "dependencies": {
    "preact": "^11.0.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
