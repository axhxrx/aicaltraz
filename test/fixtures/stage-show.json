{
  "$schema": "../../schema/buttpad.config.schema.json",
  "version": 1,
  "pads": [
    {
      "id": "show",
      "name": "本番 SHOW",
      "cols": 4,
      "rows": 3,
      "buttons": [
        { "id": "fade-in", "label": "照明 フェードイン FADE IN 10s", "color": "#7b2cbf", "x": 0, "y": 0,
          "holdMs": 300, "cooldownMs": 1500, "stops": ["show/fade-out", "show/fade-slow"],
          "action": { "type": "exec", "command": "./cues/fade.sh", "args": ["wash", "100", "10"] } },
        { "id": "fade-out", "label": "照明 フェードアウト FADE OUT 15s", "color": "#5a189a", "x": 1, "y": 0,
          "holdMs": 300, "cooldownMs": 1500, "stops": ["show/fade-in", "show/fade-slow"],
          "action": { "type": "exec", "command": "./cues/fade.sh", "args": ["wash", "0", "15"] } },
        { "id": "fade-slow", "label": "照明 ゆっくり SLOW 60s", "color": "#3c096c", "x": 2, "y": 0,
          "holdMs": 300, "cooldownMs": 1500, "stops": ["show/fade-in"],
          "action": { "type": "exec", "command": "./cues/fade.sh", "args": ["wash", "60", "60"] } },
        { "id": "blackout", "label": "暗転 BLACKOUT", "color": "#1d2433", "x": 3, "y": 0,
          "trigger": "tap", "cooldownMs": 1500,
          "stops": ["show/fade-in", "show/fade-out", "show/fade-slow", "show/spot"],
          "action": { "type": "exec", "command": "./cues/blackout.sh" } },

        { "id": "bgm", "label": "BGM START", "color": "#0077b6", "x": 0, "y": 1,
          "holdMs": 400, "cooldownMs": 1500,
          "action": { "type": "exec", "command": "./cues/bgm.sh", "args": ["opening", "75"] } },
        { "id": "bgm-stop", "label": "BGM STOP", "color": "#023e8a", "x": 1, "y": 1,
          "trigger": "tap", "stops": ["show/bgm"], "action": { "type": "none" } },
        { "id": "video", "label": "映像 VIDEO 3:00", "color": "#b5179e", "x": 2, "y": 1,
          "holdMs": 500, "cooldownMs": 1500, "timeoutMs": 150000,
          "action": { "type": "exec", "command": "./cues/video.sh", "args": ["opening.mp4", "180"] } },
        { "id": "video-stop", "label": "映像 STOP", "color": "#7209b7", "x": 3, "y": 1,
          "trigger": "tap", "stops": ["show/video"], "action": { "type": "none" } },

        { "id": "house", "label": "客電 OUT HOUSE", "color": "#a86400", "x": 0, "y": 2,
          "holdMs": 400, "cooldownMs": 1500,
          "action": { "type": "exec", "command": "./cues/house.sh", "args": ["out", "8"] } },
        { "id": "smoke", "label": "スモーク SMOKE", "color": "#6c757d", "x": 1, "y": 2,
          "trigger": "tap", "cooldownMs": 1000,
          "action": { "type": "exec", "command": "./cues/smoke.sh", "args": ["5"] } },
        { "id": "spot", "label": "ピンスポ SPOT", "color": "#e76f51", "x": 2, "y": 2,
          "trigger": "tap", "cooldownMs": 1000,
          "action": { "type": "exec", "command": "./cues/fade.sh", "args": ["spot", "100", "5"] } },
        { "id": "estop", "label": "緊急停止 EMERGENCY STOP", "color": "#c1121f", "x": 3, "y": 2,
          "trigger": "tap", "confirm": true, "confirmWindowMs": 3000, "stops": ["*"],
          "action": { "type": "none" } }
      ]
    },
    {
      "id": "backup",
      "name": "予備 BACKUP",
      "cols": 2,
      "rows": 3,
      "buttons": [
        { "id": "blackout2", "label": "暗転 BLACKOUT", "color": "#1d2433", "x": 0, "y": 0, "w": 2,
          "trigger": "tap", "cooldownMs": 1500,
          "stops": ["show/fade-in", "show/fade-out", "show/fade-slow", "show/spot"],
          "action": { "type": "exec", "command": "./cues/blackout.sh" } },
        { "id": "bgm-stop2", "label": "BGM STOP", "color": "#023e8a", "x": 0, "y": 1,
          "trigger": "tap", "stops": ["show/bgm"], "action": { "type": "none" } },
        { "id": "video-stop2", "label": "映像 STOP", "color": "#7209b7", "x": 1, "y": 1,
          "trigger": "tap", "stops": ["show/video"], "action": { "type": "none" } },
        { "id": "estop2", "label": "緊急停止 EMERGENCY STOP", "color": "#c1121f", "x": 0, "y": 2, "w": 2,
          "trigger": "tap", "confirm": true, "stops": ["*"], "action": { "type": "none" } }
      ]
    }
  ]
}
