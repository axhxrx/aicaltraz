{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ButtPad config",
  "description": "Pads of buttons that run actions on the ButtPad host. Not expressible here, but enforced by the host: unique pad ids, unique button ids per pad, buttons inside the grid and not overlapping.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "server": {
      "default": {},
      "type": "object",
      "properties": {
        "host": {
          "default": "0.0.0.0",
          "type": "string"
        },
        "port": {
          "default": 8787,
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "pads": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\w-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "cols": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "rows": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "buttons": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[\\w-]+$"
                },
                "label": {
                  "default": "",
                  "type": "string",
                  "maxLength": 200
                },
                "color": {
                  "default": "#2f6fde",
                  "type": "string"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "w": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "h": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "trigger": {
                  "default": "hold",
                  "type": "string",
                  "enum": [
                    "hold",
                    "tap",
                    "double"
                  ]
                },
                "holdMs": {
                  "default": 500,
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 5000
                },
                "driftPx": {
                  "default": 60,
                  "type": "number",
                  "minimum": 0
                },
                "whileRunning": {
                  "default": "ignore",
                  "type": "string",
                  "enum": [
                    "ignore",
                    "cancel",
                    "queue"
                  ]
                },
                "confirm": {
                  "default": false,
                  "type": "boolean"
                },
                "confirmWindowMs": {
                  "default": 3000,
                  "type": "integer",
                  "minimum": 500,
                  "maximum": 60000
                },
                "timeoutMs": {
                  "default": 120000,
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 86400000
                },
                "resultHoldMs": {
                  "default": 2500,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                },
                "cooldownMs": {
                  "default": 400,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "stops": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(\\*|[\\w-]+\\/(\\*|[\\w-]+))$"
                  }
                },
                "group": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[\\w-]+$"
                },
                "maxLatenessMs": {
                  "default": 3000,
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 10000
                },
                "key": {
                  "type": "string"
                },
                "action": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "exec"
                        },
                        "command": {
                          "type": "string",
                          "minLength": 1
                        },
                        "args": {
                          "default": [],
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "cwd": {
                          "type": "string"
                        },
                        "env": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "command"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "shell"
                        },
                        "script": {
                          "type": "string",
                          "minLength": 1
                        },
                        "shell": {
                          "type": "string"
                        },
                        "cwd": {
                          "type": "string"
                        },
                        "env": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "type",
                        "script"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "none"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "x",
                "y",
                "action"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "pads"
  ],
  "additionalProperties": false
}
